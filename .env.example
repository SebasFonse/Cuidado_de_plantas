# 1. Copia este archivo como .env en la raíz del proyecto (el .env NO se sube a GitHub)
# 2. Reemplaza los valores con los datos de tu proyecto en Neon (Dashboard > Connect)
#
# Neon entrega una cadena así:
#   postgresql://USUARIO:CONTRASEÑA@HOST/NOMBRE_BD?sslmode=require
# y aquí se separa en tres partes:
DB_URL=jdbc:postgresql://HOST/NOMBRE_BD?sslmode=require
DB_USERNAME=USUARIO
DB_PASSWORD=CONTRASEÑA

# Opcional (solo en el despliegue): dominios del frontend que pueden llamar a la API.
# CORS_ORIGINS=/http://localhost:[0-9]+/,https://TU-FRONTEND.vercel.app
